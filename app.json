{
  "expo": {
    "name": "Playon",
    "slug": "bookora",
    "version": "1.1.9",
    "orientation": "portrait",
    "icon": "./assets/images/playon-icon-v15.png",
    "scheme": "playon",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.playonnew.app",
      "buildNumber": "24",
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": "./assets/images/playon-icon-v15.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PlayOn uses your location to show nearby sports venues.",
        "NSLocationAlwaysUsageDescription": "PlayOn uses your location to show nearby sports venues.",
        "NSCameraUsageDescription": "PlayOn uses camera to upload your profile photo.",
        "NSPhotoLibraryUsageDescription": "PlayOn uses photo library to upload your profile photo.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp",
          "credpay",
          "mobikwik",
          "in.fampay.app",
          "bhim",
          "amazonpay",
          "navi",
          "kiwi",
          "payzapp",
          "jupiter",
          "omnicard",
          "icici",
          "popclubapp",
          "sbiyono",
          "myjio",
          "slice-upi",
          "bobupi",
          "shriramone",
          "indusmobile",
          "whatsapp",
          "kotakbank"
        ]
      }
    },
    "android": {
      "versionCode": 20,
      "googleServicesFile": "./google-services.json",
      "package": "com.playonnew.app",
      "softwareKeyboardLayoutMode": "pan",
            "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/playon-icon-v15.png",
        "backgroundColor": "#0B1220"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/p-notification-v5.png",
          "color": "#000000",
          "iosDisplayInForeground": true,
          "defaultChannel": "bookora-default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-v10.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-v11-dark.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#000000"
          }
        }
            ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PlayOn uses your location to show nearby sports venues."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d695092-7b98-414c-ac6e-545b406389ef"
      }
    }
  }
}
